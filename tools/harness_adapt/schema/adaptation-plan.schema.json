{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec Coding Harness Adaptation Plan V1",
  "type": "object",
  "required": ["schema_version", "semantic_fingerprint", "environment_fingerprint", "adoption_fingerprint", "clause_accounts", "requirements", "providers"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "semantic_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adoption_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "clause_accounts": {"type": "array", "items": {"type": "object", "required": ["clause", "disposition"], "additionalProperties": false, "properties": {"clause": {"type": "string", "minLength": 1}, "disposition": {"enum": ["covered", "not_applicable", "blocked"]}, "requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "reason": {"type": "string", "minLength": 1}}}},
    "requirements": {"type": "array", "items": {"type": "object", "required": ["id", "name", "semantic_guarantee", "required_by", "primitives", "provider_ids", "selected_provider", "selection_reason"], "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "semantic_guarantee": {"type": "string", "minLength": 1}, "required_by": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "primitives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "provider_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "selected_provider": {"type": "string", "minLength": 1}, "selection_reason": {"type": "string", "minLength": 1}}}},
    "providers": {"type": "array", "items": {"type": "object", "required": ["id", "source", "availability", "mechanism", "trust", "satisfies", "evidence", "requires_change", "authority_status"], "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "source": {"enum": ["runtime_native", "project_existing", "installed_extension", "registry", "external", "custom"]}, "availability": {"enum": ["active", "installable", "reachable", "buildable", "unavailable"]}, "mechanism": {"type": "string", "minLength": 1}, "trust": {"enum": ["runtime_official", "project_trusted", "third_party", "unknown"]}, "satisfies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "fact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "surface_ref": {"type": "string", "minLength": 1}, "requires_change": {"type": "boolean"}, "authority_status": {"enum": ["allowed", "approval_required", "forbidden"]}, "approval_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}}}}
  }
}
