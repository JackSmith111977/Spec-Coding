{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec Coding Harness Verification Report V1",
  "type": "object",
  "required": ["schema_version", "semantic_fingerprint", "environment_fingerprint", "adoption_fingerprint", "plan_fingerprint", "candidate_fingerprint", "verification_plan_fingerprint", "runtime_identity", "artifact_results", "provider_results", "clause_results", "mutation_results", "findings", "verdict"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "semantic_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adoption_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verification_plan_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_identity": {"$ref": "#/$defs/runtime_identity"},
    "artifact_results": {"type": "array", "items": {"type": "object", "required": ["probe_id", "artifact_ref", "runtime_visible", "evidence"], "additionalProperties": false, "properties": {"probe_id": {"type": "string", "minLength": 1}, "artifact_ref": {"type": "string", "minLength": 1}, "runtime_visible": {"type": "boolean"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}},
    "provider_results": {"type": "array", "items": {"type": "object", "required": ["probe_id", "provider_ref", "active", "evidence"], "additionalProperties": false, "properties": {"probe_id": {"type": "string", "minLength": 1}, "provider_ref": {"type": "string", "minLength": 1}, "active": {"type": "boolean"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}},
    "clause_results": {"type": "array", "items": {"type": "object", "required": ["verification_id", "clause", "verdict", "evidence"], "additionalProperties": false, "properties": {"verification_id": {"type": "string", "minLength": 1}, "clause": {"type": "string", "minLength": 1}, "verdict": {"enum": ["pass", "fail"]}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}},
    "mutation_results": {"type": "array", "items": {"type": "object", "required": ["mutation_id", "detected", "evidence"], "additionalProperties": false, "properties": {"mutation_id": {"type": "string", "minLength": 1}, "detected": {"type": "boolean"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}},
    "findings": {"type": "array", "items": {"type": "object", "required": ["id", "blocking", "fault_layer", "summary", "evidence"], "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "blocking": {"type": "boolean"}, "fault_layer": {"enum": ["semantic", "environment", "adaptation", "candidate", "runtime"]}, "summary": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}}}},
    "verdict": {"enum": ["pass", "fail"]}
  },
  "$defs": {
    "runtime_identity": {"type": "object", "required": ["target", "runtime"], "additionalProperties": false, "properties": {"target": {"type": "string", "minLength": 1}, "runtime": {"type": "string", "minLength": 1}, "runtime_version": {"type": "string", "minLength": 1}}}
  }
}
