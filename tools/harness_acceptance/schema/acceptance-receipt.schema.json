{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec Coding Harness Acceptance Receipt V1",
  "type": "object",
  "required": ["schema_version", "semantic_fingerprint", "environment_fingerprint", "adoption_fingerprint", "plan_fingerprint", "candidate_fingerprint", "verification_report_fingerprint", "runtime_identity", "executor", "cases", "final_verdict"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "semantic_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adoption_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verification_report_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_identity": {"$ref": "#/$defs/runtime_identity"},
    "executor": {"type": "object", "required": ["fresh_context", "independent", "isolation_evidence"], "additionalProperties": false, "properties": {"fresh_context": {"type": "boolean"}, "independent": {"type": "boolean"}, "isolation_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "cases": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["case_id", "category", "input", "expected_semantics", "observed_behavior", "covered_clauses", "evidence", "verdict"], "additionalProperties": false, "properties": {"case_id": {"type": "string", "minLength": 1}, "category": {"enum": ["load", "process", "boundary", "gate_lifecycle", "exception"]}, "input": {"type": "string", "minLength": 1}, "expected_semantics": {"type": "string", "minLength": 1}, "observed_behavior": {"type": "string", "minLength": 1}, "covered_clauses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "verdict": {"enum": ["pass", "fail"]}}}},
    "final_verdict": {"enum": ["READY", "BLOCKED"]}
  },
  "$defs": {
    "runtime_identity": {"type": "object", "required": ["target", "runtime"], "additionalProperties": false, "properties": {"target": {"type": "string", "minLength": 1}, "runtime": {"type": "string", "minLength": 1}, "runtime_version": {"type": "string", "minLength": 1}}}
  }
}
