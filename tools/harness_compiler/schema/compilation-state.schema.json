{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec Coding Harness Compilation State V2",
  "description": "Generated, ephemeral evidence. It does not replace Canonical Workflow, Rules, Adoption Baseline, or Runtime Evidence.",
  "type": "object",
  "required": ["compilation", "sources", "contracts", "mappings", "components", "validation"],
  "additionalProperties": false,
  "properties": {
    "compilation": {
      "type": "object",
      "required": ["spec_version", "target_id", "adoption_sha256"],
      "additionalProperties": false,
      "properties": {
        "spec_version": {"$ref": "#/$defs/nonEmptyString"},
        "target_id": {"$ref": "#/$defs/nonEmptyString"},
        "adoption_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "ref", "sha256", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/nonEmptyString"},
          "kind": {"enum": ["canonical", "adoption"]},
          "ref": {"$ref": "#/$defs/nonEmptyString"},
          "sha256": {"$ref": "#/$defs/digest"},
          "status": {"enum": ["RESOLVED", "NOT_APPLICABLE", "UNRESOLVED"]},
          "contracts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
          "guidance_only": {"type": "boolean"},
          "reason": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "guarantee", "strength"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/nonEmptyString"},
          "source": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
          "guarantee": {"$ref": "#/$defs/nonEmptyString"},
          "strength": {"enum": ["must", "must_not", "should", "guidance"]},
          "prohibits": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
          "readback_contract": {"$ref": "#/$defs/readbackContract"},
          "obligation_type": {"$ref": "#/$defs/nonEmptyString"},
          "failure_mode": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["contract", "decision"],
        "additionalProperties": false,
        "properties": {
          "contract": {"$ref": "#/$defs/nonEmptyString"},
          "decision": {"enum": ["EXISTING", "COMPILE", "BLOCKED"]},
          "existing": {
            "type": "object",
            "required": ["coverage", "mechanisms", "evidence"],
            "additionalProperties": false,
            "properties": {
              "coverage": {"const": "sufficient"},
              "mechanisms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
              "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}}
            }
          },
          "primitives": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
          "runtime": {
            "type": "object",
            "required": ["support", "surfaces", "evidence"],
            "additionalProperties": false,
            "properties": {
              "support": {"enum": ["native", "composable", "external", "unavailable", "unknown"]},
              "surfaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
              "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}}
            }
          },
          "reason": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "covers", "reason", "outputs", "verification"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/nonEmptyString"},
          "type": {"$ref": "#/$defs/nonEmptyString"},
          "covers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
          "reason": {"$ref": "#/$defs/nonEmptyString"},
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["target", "action", "staged", "content_sha256"],
              "additionalProperties": false,
              "properties": {
                "target": {"$ref": "#/$defs/nonEmptyString"},
                "action": {"enum": ["create", "modify"]},
                "staged": {"$ref": "#/$defs/nonEmptyString"},
                "content_sha256": {"$ref": "#/$defs/digest"}
              }
            }
          },
          "verification": {
            "type": "object",
            "required": ["covers", "cannot_cover", "probes"],
            "additionalProperties": false,
            "properties": {
              "covers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
              "cannot_cover": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
              "probes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/probe"}}
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["source_coverage", "contract_coverage", "semantic_fidelity", "runtime_mapping", "capability_routing", "component_integrity", "minimality", "runtime_loading", "executability", "failure_path", "reference_drift", "unresolved", "blocked"],
      "additionalProperties": false,
      "properties": {
        "source_coverage": {"$ref": "#/$defs/evidence"},
        "contract_coverage": {"$ref": "#/$defs/evidence"},
        "semantic_fidelity": {"$ref": "#/$defs/semanticEvidence"},
        "runtime_mapping": {"$ref": "#/$defs/evidence"},
        "capability_routing": {"$ref": "#/$defs/evidence"},
        "component_integrity": {"$ref": "#/$defs/evidence"},
        "minimality": {"$ref": "#/$defs/evidence"},
        "runtime_loading": {"$ref": "#/$defs/evidence"},
        "executability": {"$ref": "#/$defs/evidence"},
        "failure_path": {"$ref": "#/$defs/evidence"},
        "reference_drift": {"$ref": "#/$defs/evidence"},
        "unresolved": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
    "readbackContract": {
      "type": "object",
      "required": ["when", "canonical_doc", "mandatory"],
      "additionalProperties": false,
      "properties": {
        "when": {"$ref": "#/$defs/nonEmptyString"},
        "canonical_doc": {"$ref": "#/$defs/nonEmptyString"},
        "mandatory": {"type": "boolean"}
      }
    },
    "probe": {
      "type": "object",
      "required": ["id", "type", "covers"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "type": {"enum": ["surface", "semantic", "runtime-visibility"]},
        "covers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "command": {"$ref": "#/$defs/command"},
        "expect": {"enum": ["pass", "fail"]}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["pass", "fail"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}}
      }
    },
    "semanticEvidence": {
      "type": "object",
      "required": ["status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["pass", "fail"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "reviewer": {
          "type": "object",
          "required": ["independent", "verdict", "findings"],
          "additionalProperties": false,
          "properties": {
            "independent": {"type": "boolean"},
            "verdict": {"enum": ["pass", "fail"]},
            "findings": {"type": "array"}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "pass"}}},
          "then": {"required": ["reviewer"]}
        }
      ]
    }
  }
}
