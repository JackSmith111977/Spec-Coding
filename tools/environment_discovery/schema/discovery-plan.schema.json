{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec Coding Environment Discovery Plan V1",
  "type": "object",
  "required": ["schema_version", "semantic_fingerprint", "adoption_fingerprint", "clause_accounts", "questions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "semantic_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adoption_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "clause_accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clause", "disposition"],
        "additionalProperties": false,
        "properties": {
          "clause": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["discover", "no_environment_dependency"]},
          "question_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "question", "required_by", "evidence_required", "status", "blocking"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"enum": ["runtime", "project", "harness", "adoption"]},
          "question": {"type": "string", "minLength": 1},
          "required_by": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence_required": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "status": {"enum": ["confirmed", "not_applicable", "unknown", "blocked"]},
          "blocking": {"type": "boolean"},
          "fact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
