{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec Coding Environment Model V1",
  "type": "object",
  "required": [
    "schema_version",
    "semantic_fingerprint",
    "adoption_fingerprint",
    "identity",
    "facts",
    "capabilities",
    "provider_surfaces",
    "project_mechanisms",
    "existing_harness",
    "constraints",
    "unknowns"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "semantic_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adoption_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object",
      "required": ["target", "runtime"],
      "additionalProperties": false,
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "runtime_version": {"type": "string", "minLength": 1}
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "statement", "confidence", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"enum": ["runtime", "project", "harness", "adoption"]},
          "statement": {"type": "string", "minLength": 1},
          "confidence": {"enum": ["confirmed", "inferred"]},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "observed_at": {"type": "string", "minLength": 1}
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "support", "fact_refs"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "support": {"enum": ["native", "composable", "external", "unavailable", "unknown"]},
          "mechanism": {"type": "string", "minLength": 1},
          "fact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "provider_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "status", "query_mechanism", "trust_scope", "fact_refs"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["runtime_package", "plugin_registry", "extension_registry", "mcp_registry", "package_manager", "other"]},
          "status": {"enum": ["reachable", "unavailable", "unknown"]},
          "query_mechanism": {"type": "string", "minLength": 1},
          "install_mechanism": {"type": "string", "minLength": 1},
          "trust_scope": {"enum": ["runtime_official", "project_trusted", "third_party", "unknown"]},
          "fact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "project_mechanisms": {"$ref": "#/$defs/mechanisms"},
    "existing_harness": {"$ref": "#/$defs/mechanisms"},
    "constraints": {"$ref": "#/$defs/mechanisms"},
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "affects_clauses", "blocking"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "affects_clauses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "blocking": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "description", "fact_refs"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "fact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
