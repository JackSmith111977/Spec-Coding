{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec Coding Semantic Review Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "source_fingerprint", "reviewer", "documents", "global_verdict", "mutations"],
  "properties": {
    "receipt_version": {"const": 1},
    "source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "independent"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "independent": {"const": true}
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document", "verdict", "findings"],
        "properties": {
          "document": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["pass", "fail", "blocked"]},
          "findings": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "global_verdict": {"enum": ["pass", "fail", "blocked"]},
    "mutations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "cases"],
      "properties": {
        "status": {"enum": ["passed", "failed"]},
        "cases": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
