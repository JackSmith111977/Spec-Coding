{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec Coding Semantic IR V1",
  "type": "object",
  "required": [
    "ir_version",
    "spec_version",
    "source_fingerprint",
    "scope",
    "clauses"
  ],
  "additionalProperties": false,
  "properties": {
    "ir_version": {"const": 1},
    "spec_version": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["mode", "documents"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["pilot", "release"]},
        "documents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "source"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["invariant", "trigger", "gate", "transition", "authority", "artifact", "routing"]},
          "source": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["document", "anchor"],
              "additionalProperties": false,
              "properties": {
                "document": {"type": "string", "minLength": 1},
                "anchor": {"type": "string", "minLength": 1}
              }
            }
          },
          "when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "must": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "must_not": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "target"],
              "additionalProperties": false,
              "properties": {
                "type": {"enum": ["requires", "before", "triggers", "blocks", "specializes", "isolated_from"]},
                "target": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "anyOf": [
          {"required": ["when"]},
          {"required": ["must"]},
          {"required": ["must_not"]}
        ]
      }
    },
    "source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
